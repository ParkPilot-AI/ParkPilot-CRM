# ─────────────────────────────────────────────────────────────────────────────
# ParkPilot CRM environment variables. Copy to .env.local for local development and
# set the same keys in Netlify → Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase: the SAME project as ParkPilot ecco (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://fysaeyexcdpxbfdnqbzl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key BYPASSES Row Level Security. Server-only (audit log and the lead API).
SUPABASE_SECRET_KEY=sb_secret_...

# Canonical public address of the CRM.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ParkPilot ecco, for "Open in ecco" links.
NEXT_PUBLIC_ECCO_URL=https://ecco-parkpilot.netlify.app

# Shared secret ParkPilot AI sends as "Authorization: Bearer ..." to POST /api/v1/leads.
# At least 32 characters:  openssl rand -base64 48
# To rotate without downtime, list the new and old values comma-separated, then remove the old one.
CRM_LEAD_API_SECRET=
